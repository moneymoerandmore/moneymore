[Unit]
Description=MoneyMore production dashboard
After=network-online.target moneymore-api.service
Wants=network-online.target

[Service]
Type=simple
User=moneymore
Group=moneymore
WorkingDirectory=/opt/moneymore/current/apps/dashboard
Environment=NODE_ENV=production
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/moneymore/current/apps/dashboard/.wrangler /opt/moneymore/current/logs

[Install]
WantedBy=multi-user.target
